<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_arka"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/logo"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_ust"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Sıradaki ders"
            android:textColor="@color/widget_soluk"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_tarih"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_soluk"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_ana"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="LimeOBS"
        android:textColor="@color/widget_yazi"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_alt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Uygulamayı bir kez açınca dolacak"
        android:textColor="@color/widget_vurgu"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/widget_cizgi"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/widget_cizgi"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widget_odev1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_yazi"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_odev2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_yazi"
        android:textSize="13sp" />
</LinearLayout>
